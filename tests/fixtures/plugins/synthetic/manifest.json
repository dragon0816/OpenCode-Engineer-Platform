{
  "format": "oep.plugin/v1",
  "id": "oep.synthetic",
  "version": "1.0.0",
  "name": { "en": "Synthetic plugin", "zh-TW": "合成外掛" },
  "publisher": "Synthetic OEP fixture",
  "oepCompatibility": ">=0.7.0 <0.9.0",
  "permissions": {
    "operations": ["worker.run", "data.read", "data.write", "progress.emit", "review.submit", "publish.request"],
    "dataScope": "plugin-workspace",
    "workers": ["oep.synthetic.worker"],
    "modelBroker": "approved-gateway",
    "sourceBroker": "approved-sources"
  },
  "components": {
    "skills": [],
    "workflows": [],
    "pythonWorkers": [{ "id": "oep.synthetic.worker", "version": "1.0.0", "entry": "worker.py" }],
    "dataSchemas": [{ "id": "oep.synthetic.schema", "version": "1.0.0", "entry": "schema.json" }],
    "pages": [{
      "id": "oep.synthetic.page",
      "version": "1.0.0",
      "entry": "page.json",
      "titleKey": "page.title",
      "strings": { "en": "en.json", "zh-TW": "zh-TW.json" }
    }],
    "panels": [{
      "id": "oep.synthetic.panel", "version": "1.0.0", "entry": "panel.json", "titleKey": "panel.title",
      "strings": { "en": "panel-en.json", "zh-TW": "panel-zh.json" }
    }],
    "reviewTypes": [{ "id": "oep.synthetic.review", "version": "1.0.0", "schema": "oep.synthetic.schema" }],
    "collections": [{
      "id": "oep.synthetic.results", "version": "1.0.0", "schema": "oep.synthetic.schema", "uniqueKey": "measurement",
      "readScope": "plugin-workspace", "writeScope": "plugin-workspace", "requiresReview": true
    }]
  }
}
