{
  "name": "oep-phase-zero",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "node scripts/phase0/lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/phase0/*.test.ts tests/contract/*.test.ts",
    "test:contract": "node --test tests/contract/*.test.ts",
    "test:knowledge": "node --disable-warning=ExperimentalWarning --test tests/contract/knowledge*.test.ts",
    "test:e2e:mcp": "node --disable-warning=ExperimentalWarning tests/e2e/custom-mcp.ts && node --disable-warning=ExperimentalWarning tests/e2e/custom-mcp-probe.ts && node --disable-warning=ExperimentalWarning tests/e2e/custom-mcp-remote.mjs && node --disable-warning=ExperimentalWarning tests/e2e/custom-mcp-browser.ts --leaks",
    "test:e2e:knowledge": "node --disable-warning=ExperimentalWarning --test tests/e2e/knowledge.test.ts",
    "knowledge:migrate": "node --disable-warning=ExperimentalWarning scripts/knowledge/migrate.ts",
    "knowledge:inspect": "node --disable-warning=ExperimentalWarning scripts/knowledge/inspect.ts",
    "knowledge:benchmark": "node --disable-warning=ExperimentalWarning scripts/knowledge/benchmark.ts",
    "test:contract:native": "node --disable-warning=ExperimentalWarning tests/e2e/native-contract.ts",
    "test:e2e:excel": "node --disable-warning=ExperimentalWarning tests/e2e/sop-to-xlsx.test.ts",
    "test:e2e:excel:faults": "node --disable-warning=ExperimentalWarning tests/e2e/sop-to-xlsx.test.ts --faults",
    "test:e2e:excel:synthetic": "node --disable-warning=ExperimentalWarning tests/e2e/sop-to-xlsx.test.ts --synthetic",
    "test:e2e:web": "node --disable-warning=ExperimentalWarning tests/e2e/web-http.ts",
    "test:e2e:web:real": "node --disable-warning=ExperimentalWarning tests/e2e/web-http.ts --real",
    "test:e2e:browser": "node --disable-warning=ExperimentalWarning tests/e2e/web-browser.test.ts",
    "test:e2e:browser:real": "node --disable-warning=ExperimentalWarning tests/e2e/web-browser.test.ts --real",
    "test:e2e:windows": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/e2e/windows-launch.test.ts tests/e2e/sse-recovery.test.ts tests/e2e/web-browser.test.ts",
    "runtime": "node --disable-warning=ExperimentalWarning apps/launcher/src/main.ts",
    "build": "tsc --outDir .phase0/build",
    "scan": "node scripts/phase0/secret-scan.mjs --tree",
    "merge-check": "node scripts/phase0/merge-check.mjs",
    "test:ingest": "node --disable-warning=ExperimentalWarning --test tests/integration/ingest-publish.test.ts",
    "test:telegram": "node --disable-warning=ExperimentalWarning --test tests/integration/telegram.test.ts",
    "build:release": "node scripts/release/build-release.mjs",
    "test:install": "node --test tests/e2e/install.test.ts",
    "test:backup": "node --disable-warning=ExperimentalWarning --test tests/e2e/backup-restore.test.ts",
    "test:release:determinism": "node --test scripts/release/determinism.test.mjs",
    "test:compliance": "node --test scripts/release/compliance.test.mjs",
    "test:release:bundled": "node --disable-warning=ExperimentalWarning --test tests/e2e/bundled-release.test.ts",
    "test:upgrade": "node --disable-warning=ExperimentalWarning --test tests/e2e/upgrade-rollback.test.ts"
  },
  "dependencies": {
    "@opencode/client": "2.3.2",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "6.0.3"
  }
}
